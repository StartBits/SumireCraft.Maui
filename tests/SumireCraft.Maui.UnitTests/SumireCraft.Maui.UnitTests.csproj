<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, which the libraries build for alongside the platforms: no platform is
         involved, so the tests run on any operating system, and views can be built in them. -->
    <TargetFramework>$(SumirePlainTargetFramework)</TargetFramework>

    <!-- xUnit.net v3 builds a test project into an executable that runs its own tests. -->
    <OutputType>Exe</OutputType>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <RootNamespace>SumireCraft.Maui.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SumireCraft.Maui.Controls\SumireCraft.Maui.Controls.csproj" />
    <ProjectReference Include="..\..\src\SumireCraft.Maui.Core\SumireCraft.Maui.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
