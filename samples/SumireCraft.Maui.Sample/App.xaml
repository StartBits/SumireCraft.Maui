<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SumireCraft.Maui.Sample"
             x:Class="SumireCraft.Maui.Sample.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Every SmrField's title, restyled once for the whole application without writing a
           template. Indented a little, to line up with the text inside an entry. A UI test reads
           the indent to see that a style here reaches the label inside a field's template. -->
      <Style TargetType="Label" Class="SmrFieldTitle">
        <Setter Property="Margin" Value="4,0,0,4" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
