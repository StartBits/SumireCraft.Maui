<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:smr="https://github.com/startbits/SumireCraft.Maui"
             xmlns:abc="clr-namespace:SumireCraft.Maui.Sample.Wrapping"
             x:Class="SumireCraft.Maui.Sample.Pages.UnderlinePage"
             Title="SmrUnderline">

  <!-- What the tests look for is at the top, on a phone's first screen without scrolling: Android
       leaves whatever is below the screen out of the tree. The rest is for reading by hand. -->
  <ScrollView AutomationId="UnderlinePageScroll">
    <VerticalStackLayout
      Padding="24"
      Spacing="16">

      <Label
        AutomationId="UnderlinePageTitle"
        Text="SmrUnderline"
        Style="{StaticResource Headline}"
        HorizontalTextAlignment="Start" />

      <Label
        Text="Each input stands on a line instead of the platform's box, in the text's colour unless given one, thicker while it has the focus." />

      <Entry
        AutomationId="UnderlinedEntry"
        Placeholder="Entry"
        smr:SmrUnderline.IsEnabled="True" />

      <Entry
        AutomationId="ColouredEntry"
        Placeholder="Teal text on a purple line"
        TextColor="Teal"
        smr:SmrUnderline.IsEnabled="True"
        smr:SmrUnderline.Color="Purple" />

      <!-- Turned off, the entry has the platform's box back; given a background, it keeps its line. -->
      <HorizontalStackLayout Spacing="8">
        <Switch
          x:Name="UnderlineSwitch"
          AutomationId="UnderlineSwitch"
          IsToggled="True" />
        <Label
          AutomationId="UnderlineState"
          VerticalTextAlignment="Center">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsToggled, Source={x:Reference UnderlineSwitch}}" Value="True">
              <Setter Property="Text" Value="Underlined" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding IsToggled, Source={x:Reference UnderlineSwitch}}" Value="False">
              <Setter Property="Text" Value="Not underlined" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
        <Switch
          x:Name="BackgroundSwitch"
          AutomationId="BackgroundSwitch" />
        <Label
          AutomationId="BackgroundState"
          VerticalTextAlignment="Center">
          <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsToggled, Source={x:Reference BackgroundSwitch}}" Value="True">
              <Setter Property="Text" Value="On a background" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Binding="{Binding IsToggled, Source={x:Reference BackgroundSwitch}}" Value="False">
              <Setter Property="Text" Value="On the page" />
            </DataTrigger>
          </Label.Triggers>
        </Label>
      </HorizontalStackLayout>

      <Entry
        AutomationId="ToggledEntry"
        Placeholder="On a red line, while the switch is on"
        smr:SmrUnderline.IsEnabled="{Binding IsToggled, Source={x:Reference UnderlineSwitch}}"
        smr:SmrUnderline.Color="Red">
        <Entry.Triggers>
          <DataTrigger TargetType="Entry" Binding="{Binding IsToggled, Source={x:Reference BackgroundSwitch}}" Value="True">
            <Setter Property="BackgroundColor" Value="#EADDFF" />
          </DataTrigger>
        </Entry.Triggers>
      </Entry>

      <!-- Each of the other inputs on a line of a colour of its own, for a test to tell them apart. -->
      <Editor
        AutomationId="UnderlinedEditor"
        Placeholder="Editor, on an orange line"
        HeightRequest="64"
        smr:SmrUnderline.IsEnabled="True"
        smr:SmrUnderline.Color="DarkOrange" />

      <Picker
        AutomationId="UnderlinedPicker"
        Title="Picker, on a green line"
        smr:SmrUnderline.IsEnabled="True"
        smr:SmrUnderline.Color="Green">
        <Picker.ItemsSource>
          <x:Array Type="{x:Type x:String}">
            <x:String>One</x:String>
            <x:String>Two</x:String>
            <x:String>Three</x:String>
          </x:Array>
        </Picker.ItemsSource>
      </Picker>

      <!-- Side by side, to stay on a phone's first screen. On Mac Catalyst these two are the
           system's date picker, a pill, and are left as they are. -->
      <Grid
        ColumnDefinitions="*,*"
        ColumnSpacing="12">
        <DatePicker
          AutomationId="UnderlinedDatePicker"
          smr:SmrUnderline.IsEnabled="True"
          smr:SmrUnderline.Color="Blue" />
        <TimePicker
          Grid.Column="1"
          AutomationId="UnderlinedTimePicker"
          smr:SmrUnderline.IsEnabled="True"
          smr:SmrUnderline.Color="Teal" />
      </Grid>

      <Entry
        AutomationId="PlainEntry"
        Placeholder="Not underlined, for comparison" />

      <!-- An entry of the application's own that is always underlined: Wrapping/AbcUnderlineEntry. -->
      <abc:AbcUnderlineEntry
        AutomationId="AbcUnderlineEntry"
        Placeholder="AbcUnderlineEntry, underlined by itself" />

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
