<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SumireCraft.Maui.Sample.Pages.ObservedPage"
             Title="Observed page">

  <VerticalStackLayout
    Padding="24"
    Spacing="16">

    <Label
      Text="This page is counted in while it is connected, and out as it closes." />

    <Label
      x:Name="CountLabel"
      AutomationId="ObservedPageCount"
      FontAttributes="Bold" />

    <Button
      x:Name="AnotherButton"
      AutomationId="PushAnotherObservedPage"
      Text="Push another"
      Clicked="OnAnotherClicked" />

    <!-- Not "Close", which Windows already shows as the window's own button. -->
    <Button
      AutomationId="ObservedPageBack"
      Text="Back"
      Clicked="OnBackClicked" />

  </VerticalStackLayout>

</ContentPage>
