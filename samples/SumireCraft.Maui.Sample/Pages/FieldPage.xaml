<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:smr="https://github.com/startbits/SumireCraft.Maui"
             xmlns:abc="clr-namespace:SumireCraft.Maui.Sample.Wrapping"
             x:Class="SumireCraft.Maui.Sample.Pages.FieldPage"
             Title="SmrField">

  <!-- What the tests look for is near the top, on a phone's first screen without scrolling: Android
       leaves whatever is below the screen out of the tree, and the markers under the fields have to
       be found. The wrapped field at the bottom is for reading by hand. -->
  <ScrollView>
    <VerticalStackLayout
      Padding="24"
      Spacing="16">

      <Label
        AutomationId="FieldPageTitle"
        Text="SmrField"
        Style="{StaticResource Headline}"
        HorizontalTextAlignment="Start" />

      <Label
        Text="A title above the entry and an error below it. The titles here are indented by a style for the SmrFieldTitle class in App.xaml, which reaches every SmrField that keeps that class. Name and Note are required, Note with a mark of its own. Email is a field wrapped in a type of the application's own, which names classes of its own: its bold, indented title comes from a style for AbcEntryFieldTitle instead." />

      <HorizontalStackLayout Spacing="8">
        <Button
          AutomationId="ToggleErrors"
          Text="Errors"
          Command="{Binding ToggleErrorsCommand}" />
        <Label
          AutomationId="ErrorsState"
          Text="{Binding ErrorsState}"
          VerticalTextAlignment="Center" />
      </HorizontalStackLayout>

      <!-- Keeps a line for its error, the default, so the marker under it stays where it is. -->
      <VerticalStackLayout Spacing="0">
        <smr:SmrField
          Title="Name"
          ErrorText="{Binding NameError}"
          IsRequired="True"
          RequiredMarkDescription="required">
          <Entry
            AutomationId="NameEntry"
            Text="{Binding Name}" />
        </smr:SmrField>
        <Label
          AutomationId="BelowReserved"
          Text="Stays put when the error appears." />
      </VerticalStackLayout>

      <!-- Closes up with no error, so the marker under it moves down when one appears. -->
      <VerticalStackLayout Spacing="0">
        <smr:SmrField
          Title="Note"
          ErrorText="{Binding NoteError}"
          ReserveErrorSpace="False"
          IsRequired="True"
          RequiredMark=" (required)">
          <Entry
            AutomationId="NoteEntry"
            Text="{Binding Note}" />
        </smr:SmrField>
        <Label
          AutomationId="BelowClosed"
          Text="Moves down when the error appears." />
      </VerticalStackLayout>

      <!-- Side by side: the field without a title keeps a line for one, so the two entries line up. -->
      <Grid
        ColumnDefinitions="*,*"
        ColumnSpacing="12">
        <smr:SmrField Title="City">
          <Entry AutomationId="CityEntry" />
        </smr:SmrField>
        <smr:SmrField
          Grid.Column="1"
          ReserveTitleSpace="True">
          <Entry AutomationId="DistrictEntry" />
        </smr:SmrField>
      </Grid>

      <!-- The field wrapped in a type the application owns, Wrapping/AbcEntryField: the page names
           neither SmrField nor the entry, and the bold title comes from a style for the class
           AbcEntryFieldTitle in App.xaml. Last on the page, below the markers the tests look for. -->
      <abc:AbcEntryField
        Title="Email"
        Text="{Binding Email}"
        ErrorText="{Binding EmailError}"
        IsRequired="True"
        RequiredMarkDescription="required" />

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
